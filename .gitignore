# Secrets and environment files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.git-credentials
.netrc
secrets.*
*secret*
*token*

# Blizzard CDN download cache (refetched on demand by tools/casc.py)
